{
  "expo": {
    "name": "Косметичка",
    "slug": "kosmetichka",
    "scheme": "kosmetichka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "ru.kosmetichkaopt.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна, чтобы сканировать штрихкоды товаров.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ru.kosmetichkaopt.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundImage": "./assets/adaptive-background.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы сканировать штрихкоды товаров.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "./plugins/withUiScale",
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к фото нужен, чтобы отправлять фото и видео менеджеру в чате заказа.",
          "cameraPermission": "Камера нужна, чтобы сканировать штрихкоды и снимать фото для менеджера.",
          "microphonePermission": "Микрофон нужен, чтобы записывать видео для менеджера."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": "2",
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "url": "https://u.expo.dev/79cf0a1d-4e68-4bdf-9389-10a7fc8bdc48"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "79cf0a1d-4e68-4bdf-9389-10a7fc8bdc48"
      }
    },
    "owner": "doshaeww"
  }
}
